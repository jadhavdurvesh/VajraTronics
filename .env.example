# Create a Supabase project and add these values locally and in Vercel.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# SENTINEL server-side edge protection (set in Vercel Project Environment Variables).
# These values are read only by middleware.js; never prefix them with VITE_.
SENTINEL_API_URL=https://project-sentinel-ivory.vercel.app
SENTINEL_PUBLIC_ORIGIN=https://project-sentinel-ivory.vercel.app
SENTINEL_SITE_ID=vajratronics
SENTINEL_INGEST_TOKEN=
