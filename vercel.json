{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/((?!api/|assets/|fonts/|.*\\.(?:js|css|png|jpe?g|svg|webp|avif|woff2?|ttf|map|ico|xml|txt|webmanifest)$).*)"]
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
